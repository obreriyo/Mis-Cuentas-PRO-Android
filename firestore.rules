rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/main {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['schemaVersion', 'revision', 'payload', 'commitId', 'updatedAt'])
          && d.keys().hasOnly(['schemaVersion', 'revision', 'payload', 'commitId', 'updatedAt'])
          && d.schemaVersion == 2 && d.revision is int
          && d.payload is string && d.payload.size() <= 850000
          && d.commitId is string && d.commitId.size() <= 80
          && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
